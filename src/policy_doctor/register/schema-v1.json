{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roboclue:provenance-register:entry:1",
  "title": "RoboClue curated register entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "stacks",
    "claim_basis",
    "applies_when",
    "violation_when",
    "severity",
    "evidence",
    "healthy_controls",
    "first_fix",
    "unknown_when",
    "last_verified",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,95}$"
    },
    "kind": {
      "enum": [
        "version_trap",
        "recipe",
        "contract"
      ]
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "stacks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,99}$"
      }
    },
    "claim_basis": {
      "enum": [
        "release_metadata",
        "source_bytes"
      ]
    },
    "applies_when": {
      "$ref": "#/$defs/predicates"
    },
    "violation_when": {
      "type": "array",
      "minItems": 0,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/predicate"
      }
    },
    "severity": {
      "enum": [
        "ERROR",
        "WARNING"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "quote",
          "source"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://[^/]+/",
            "maxLength": 2048
          },
          "quote": {
            "$ref": "#/$defs/text"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "sha",
              "path",
              "line"
            ],
            "properties": {
              "repo": {
                "$ref": "#/$defs/text"
              },
              "sha": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "path": {
                "$ref": "#/$defs/path"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000000
              }
            }
          },
          "basis": {
            "enum": [
              "user_report",
              "maintainer_statement",
              "publisher_recipe"
            ]
          }
        }
      }
    },
    "healthy_controls": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "first_fix": {
      "$ref": "#/$defs/text"
    },
    "unknown_when": {
      "$ref": "#/$defs/text"
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "record"
      ],
      "properties": {
        "status": {
          "const": "confirmed"
        },
        "record": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "launch_target": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(script|module|entrypoint):.+$",
        "maxLength": 2048
      }
    },
    "recipe_field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "checkpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "status": {
              "const": "published"
            },
            "published_value": {},
            "source_index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            }
          },
          "required": [
            "field",
            "checkpoint",
            "status",
            "published_value",
            "source_index"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "checkpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "status": {
              "const": "conflict"
            },
            "reason": {
              "$ref": "#/$defs/text"
            },
            "source_indices": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            }
          },
          "required": [
            "field",
            "checkpoint",
            "status",
            "reason",
            "source_indices"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "checkpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "status": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "field",
            "checkpoint",
            "status",
            "reason"
          ]
        }
      ]
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "texts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "predicates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/predicate"
      }
    },
    "value_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "op"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+){0,15}$",
          "maxLength": 256
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "exists",
            "lt",
            "lte",
            "gt",
            "gte"
          ]
        },
        "value": {},
        "default_when_absent": {
          "$ref": "#/$defs/default_when_absent"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "exists"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "in"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "lt",
                  "lte",
                  "gt",
                  "gte"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "predicate": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "checkpoint_id_in": {
          "$ref": "#/$defs/texts"
        },
        "source_contains": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "literal"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "literal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "occurrences": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": false,
              "properties": {
                "gte": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                },
                "eq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                }
              }
            }
          }
        },
        "config_key": {
          "$ref": "#/$defs/value_test"
        },
        "processor_key": {
          "$ref": "#/$defs/value_test"
        },
        "launch_flag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flag",
            "op"
          ],
          "properties": {
            "flag": {
              "type": "string",
              "pattern": "^--[a-zA-Z0-9][a-zA-Z0-9_.-]*$",
              "maxLength": 256
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "in",
                "exists"
              ]
            },
            "value": {},
            "default_when_absent": {
              "$ref": "#/$defs/default_when_absent"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "exists"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "value"
                  ]
                }
              },
              "else": {
                "required": [
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "op": {
                    "const": "in"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32
                  }
                }
              }
            }
          ]
        },
        "package_version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "version"
          ],
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}$"
            },
            "version": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "eq": {
                  "$ref": "#/$defs/version"
                },
                "gt": {
                  "$ref": "#/$defs/version"
                },
                "gte": {
                  "$ref": "#/$defs/version"
                },
                "lt": {
                  "$ref": "#/$defs/version"
                },
                "lte": {
                  "$ref": "#/$defs/version"
                }
              },
              "allOf": [
                {
                  "not": {
                    "required": [
                      "gt",
                      "gte"
                    ]
                  }
                },
                {
                  "not": {
                    "required": [
                      "lt",
                      "lte"
                    ]
                  }
                },
                {
                  "if": {
                    "required": [
                      "eq"
                    ]
                  },
                  "then": {
                    "maxProperties": 1
                  }
                }
              ]
            }
          }
        },
        "source_files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "oneOf": [
                  {
                    "required": [
                      "sha256"
                    ]
                  },
                  {
                    "required": [
                      "sha256_in"
                    ]
                  }
                ],
                "properties": {
                  "path": {
                    "$ref": "#/$defs/path"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "sha256_in": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 32,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "format": "pep440"
    },
    "default_when_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source",
        "sha256"
      ],
      "properties": {
        "value": {},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repo",
            "sha",
            "path",
            "line"
          ],
          "properties": {
            "repo": {
              "$ref": "#/$defs/text"
            },
            "sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "path": {
              "$ref": "#/$defs/path"
            },
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            }
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim_basis": {
            "const": "source_bytes"
          }
        }
      },
      "then": {
        "properties": {
          "applies_when": {
            "contains": {
              "anyOf": [
                {
                  "required": [
                    "source_files"
                  ]
                },
                {
                  "required": [
                    "source_contains"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "properties": {
        "violation_when": {
          "items": {
            "not": {
              "required": [
                "source_contains"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "recipe"
          }
        }
      },
      "then": {
        "required": [
          "recipe_field"
        ],
        "properties": {
          "evidence": {
            "items": {
              "required": [
                "basis"
              ]
            }
          },
          "applies_when": {
            "contains": {
              "required": [
                "checkpoint_id_in"
              ]
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "recipe_field"
          ]
        },
        "properties": {
          "violation_when": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recipe_field": {
            "properties": {
              "status": {
                "const": "published"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "recipe_field"
        ]
      },
      "then": {
        "properties": {
          "violation_when": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recipe_field": {
            "properties": {
              "status": {
                "enum": [
                  "conflict",
                  "unknown"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "recipe_field"
        ]
      },
      "then": {
        "properties": {
          "violation_when": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
